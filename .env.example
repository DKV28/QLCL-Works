# Sao chép file này thành .env.local và điền giá trị từ Supabase project của bạn.

# Dùng ở cả client và server (an toàn để lộ ra trình duyệt)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# CHỈ dùng phía server (tạo/mời tài khoản trong trang quản trị).
# TUYỆT ĐỐI không để lộ ra client, không commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
